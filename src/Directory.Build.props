<Project>
  <PropertyGroup>
    <VersionMajor>0</VersionMajor>
    <VersionMinor>1</VersionMinor>
    <VersionPatch>0</VersionPatch>
    <VersionPrefix>$(VersionMajor).$(VersionMinor).$(VersionPatch)</VersionPrefix>

    <BuildCounterFile>$([MSBuild]::NormalizePath($(MSBuildThisFileDirectory)..\build\build-counter.txt))</BuildCounterFile>
    <BuildCounterRaw>$([System.IO.File]::ReadAllText($(BuildCounterFile)).Trim())</BuildCounterRaw>
    <StoredPrefix>$([System.String]::Copy('$(BuildCounterRaw)').Split('|')[0])</StoredPrefix>
    <StoredCounter>$([System.String]::Copy('$(BuildCounterRaw)').Split('|')[1])</StoredCounter>
    <BuildCounter Condition="'$(StoredPrefix)' == '$(VersionPrefix)'">$(StoredCounter)</BuildCounter>
    <BuildCounter Condition="'$(StoredPrefix)' != '$(VersionPrefix)'">0</BuildCounter>

    <AssemblyVersion>$(VersionPrefix).$(BuildCounter)</AssemblyVersion>
    <FileVersion>$(VersionPrefix).$(BuildCounter)</FileVersion>
    <InformationalVersion>$(VersionPrefix)-build.$(BuildCounter)</InformationalVersion>
    <Version>$(VersionPrefix)-build.$(BuildCounter)</Version>

    <Authors>Marcelo Frau</Authors>
    <Company>Arcana</Company>
    <Copyright>Copyright (c) Marcelo Frau 2026</Copyright>
    <RepositoryUrl>https://github.com/marcelofrau/arcana</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
</Project>
