<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Arcana.App.ViewModels"
        xmlns:l="using:Arcana.App.Localization"
        xmlns:icons="using:Arcana.App.Icons"
        x:Class="Arcana.App.Views.Dialogs.PasswordDialog"
        x:DataType="vm:PasswordViewModel"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource AppSurfaceRaisedBrush}"
        Title="{Binding Title}">
    <StackPanel Margin="20" Spacing="12">
        <TextBlock Text="{Binding Title}"
                   FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource AppTextPrimaryBrush}"/>
        <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto"
              RowSpacing="10" ColumnSpacing="10">
            <TextBlock Text="{l:Loc Key=dialog.password.password}" VerticalAlignment="Center"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
            <TextBox Grid.Column="1"
                     Text="{Binding Password, Mode=TwoWay}"
                     PasswordChar="●"
                     Background="{DynamicResource AppBackgroundBrush}"
                     Foreground="{DynamicResource AppTextPrimaryBrush}"
                     BorderBrush="{DynamicResource AppBorderBrush}"
                     Padding="6,3"/>
            <TextBlock Grid.Row="1" Text="{l:Loc Key=dialog.password.confirm}" VerticalAlignment="Center"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
            <TextBox Grid.Row="1" Grid.Column="1"
                     Text="{Binding Confirm, Mode=TwoWay}"
                     PasswordChar="●"
                     Background="{DynamicResource AppBackgroundBrush}"
                     Foreground="{DynamicResource AppTextPrimaryBrush}"
                     BorderBrush="{DynamicResource AppBorderBrush}"
                     Padding="6,3"/>
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button MinWidth="90" Classes="secondary" Click="OnCancelClick">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Image Width="14" Height="14" Stretch="Uniform"
                           Tag="{x:Static icons:IconKey.Close}"
                           Source="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource IconToImage}}"/>
                    <TextBlock Text="{l:Loc Key=common.cancel}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button MinWidth="90" Classes="accent"
                    Click="OnOkClick">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Image Width="14" Height="14" Stretch="Uniform"
                           Tag="{x:Static icons:IconKey.Check}"
                           Source="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource IconToImage}}"/>
                    <TextBlock Text="{l:Loc Key=common.ok}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </StackPanel>
</Window>
