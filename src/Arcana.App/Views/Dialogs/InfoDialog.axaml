<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Arcana.App.ViewModels"
        xmlns:l="using:Arcana.App.Localization"
        x:Class="Arcana.App.Views.Dialogs.InfoDialog"
        x:DataType="vm:InfoViewModel"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource AppSurfaceRaisedBrush}"
        Title="{Binding Title}">
    <StackPanel Margin="20" Spacing="16">
        <TextBlock Text="{Binding Title}"
                   FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource AppTextPrimaryBrush}"/>
        <TextBlock Text="{Binding Message}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
        <StackPanel HorizontalAlignment="Right">
            <Button Content="{l:Loc Key=common.ok}" MinWidth="90"
                    Click="OnOkClick"
                    Background="{DynamicResource AppAccentBrush}"
                    Foreground="White"/>
        </StackPanel>
    </StackPanel>
</Window>
