<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Arcana.App.ViewModels"
        xmlns:l="using:Arcana.App.Localization"
        xmlns:icons="using:Arcana.App.Icons"
        x:Class="Arcana.App.Views.Dialogs.InfoDialog"
        x:DataType="vm:InfoViewModel"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource AppSurfaceRaisedBrush}"
        Title="{Binding Title}">
    <StackPanel Margin="20" Spacing="16">
        <TextBlock Text="{Binding Title}"
                   FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource AppTextPrimaryBrush}"/>
        <TextBlock Text="{Binding Message}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
        <CheckBox IsVisible="{Binding ShowApplyToAll}" IsChecked="{Binding ApplyToAll, Mode=TwoWay}"
                  Content="{l:Loc Key=msg.applyToAll}"/>
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
            <Button x:Name="SecondActionButton" MinWidth="90" Classes="secondary"
                    Click="OnSecondActionClick" IsVisible="False"
                    Content="{Binding SecondActionButtonText}"/>
            <Button x:Name="ActionButton" MinWidth="110" Classes="accent"
                    Click="OnActionClick"
                    IsVisible="False">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Image Width="14" Height="14" Stretch="Uniform"
                           Tag="{x:Static icons:IconKey.Folder}"
                           Source="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource IconToImage}}"/>
                    <TextBlock Text="{Binding ActionButtonText}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button MinWidth="90" Classes="accent"
                    Click="OnOkClick">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Image Width="14" Height="14" Stretch="Uniform"
                           Tag="{x:Static icons:IconKey.Check}"
                           Source="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource IconToImage}}"/>
                    <TextBlock Text="{Binding DismissText}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </StackPanel>
</Window>
