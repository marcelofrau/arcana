<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Arcana.App.ViewModels"
        xmlns:l="using:Arcana.App.Localization"
        xmlns:icons="using:Arcana.App.Icons"
        x:Class="Arcana.App.Views.Dialogs.HashFileDialog"
        x:DataType="vm:HashFileViewModel"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource AppSurfaceRaisedBrush}"
        Title="{l:Loc Key=dialog.hash.title}">
    <StackPanel Margin="20" Spacing="12">
        <TextBlock Text="{l:Loc Key=dialog.hash.title}"
                   FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource AppTextPrimaryBrush}"/>
        <TextBlock Text="{Binding FilePath}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
        <Grid ColumnDefinitions="120,*"
              RowDefinitions="Auto"
              RowSpacing="10" ColumnSpacing="10">
            <TextBlock Text="{l:Loc Key=dialog.hash.algorithm}" VerticalAlignment="Center"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding Algorithms}"
                      SelectedItem="{Binding Algorithm, Mode=TwoWay}"/>
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button MinWidth="90" Classes="secondary" Click="OnCancelClick">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Image Width="14" Height="14" Stretch="Uniform"
                           Tag="{x:Static icons:IconKey.Close}"
                           Source="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource IconToImage}}"/>
                    <TextBlock Text="{l:Loc Key=common.cancel}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button MinWidth="90" Classes="accent"
                    Click="OnOkClick">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Image Width="14" Height="14" Stretch="Uniform"
                           Tag="{x:Static icons:IconKey.Check}"
                           Source="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource IconToImage}}"/>
                    <TextBlock Text="{l:Loc Key=common.ok}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </StackPanel>
</Window>
