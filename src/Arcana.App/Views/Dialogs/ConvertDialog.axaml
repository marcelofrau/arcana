<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Arcana.App.ViewModels"
        xmlns:l="using:Arcana.App.Localization"
        x:Class="Arcana.App.Views.Dialogs.ConvertDialog"
        x:DataType="vm:ConvertViewModel"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource AppSurfaceRaisedBrush}"
        Title="{l:Loc Key=dialog.convert.title}">
    <StackPanel Margin="20" Spacing="12">
        <TextBlock Text="{l:Loc Key=dialog.convert.title}"
                   FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource AppTextPrimaryBrush}"/>
        <TextBlock Text="{Binding SourceName}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
        <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto"
              RowSpacing="10" ColumnSpacing="10">
            <TextBlock Text="{l:Loc Key=dialog.convert.format}" VerticalAlignment="Center"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding Formats}"
                      SelectedItem="{Binding Format, Mode=TwoWay}"/>
            <TextBlock Grid.Row="1" Text="{l:Loc Key=dialog.settings.compressionLevel}" VerticalAlignment="Center"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
            <ComboBox Grid.Row="1" Grid.Column="1"
                      ItemsSource="{Binding Levels}"
                      SelectedItem="{Binding Level, Mode=TwoWay}"/>
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="{l:Loc Key=common.cancel}" MinWidth="90" Click="OnCancelClick"/>
            <Button Content="{l:Loc Key=common.ok}" MinWidth="90"
                    Click="OnOkClick"
                    Background="{DynamicResource AppAccentBrush}"
                    Foreground="White"/>
        </StackPanel>
    </StackPanel>
</Window>
