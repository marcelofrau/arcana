<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Arcana.App.Localization"
        xmlns:icons="using:Arcana.App.Icons"
        x:Class="Arcana.App.Views.Dialogs.ErrorDialog"
        Width="620"
        Height="440"
        MinWidth="520"
        MinHeight="380"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        ShowInTaskbar="False"
        Background="{DynamicResource AppSurfaceRaisedBrush}"
        Title="{l:Loc Key=error.title}">
    <DockPanel Margin="22">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
            <Button MinWidth="110" Classes="secondary" Click="OnExitClick">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Image Width="14" Height="14" Stretch="Uniform"
                           Tag="{x:Static icons:IconKey.Close}"
                           Source="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource IconToImage}}"/>
                    <TextBlock Text="{l:Loc Key=error.exit}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button MinWidth="110" Classes="secondary" Click="OnRestartClick">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Image Width="14" Height="14" Stretch="Uniform"
                           Tag="{x:Static icons:IconKey.Refresh}"
                           Source="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource IconToImage}}"/>
                    <TextBlock Text="{l:Loc Key=error.restart}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button MinWidth="110" Classes="accent" Click="OnContinueClick">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Image Width="14" Height="14" Stretch="Uniform"
                           Tag="{x:Static icons:IconKey.Play}"
                           Source="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource IconToImage}}"/>
                    <TextBlock Text="{l:Loc Key=error.continue}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <Grid RowDefinitions="Auto,Auto,Auto,*" ColumnDefinitions="Auto,*" Margin="0,0,0,8">
            <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                    Width="44" Height="44" CornerRadius="22"
                    Background="{DynamicResource AppErrorBrush}"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,14,0">
                <Image Tag="{x:Static icons:IconKey.Warning}"
                       Source="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource IconToImage}}"
                       Width="26" Height="26" Stretch="Uniform"/>
            </Border>

            <TextBlock Grid.Row="0" Grid.Column="1"
                       Text="{l:Loc Key=error.title}"
                       FontSize="17" FontWeight="SemiBold"
                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Row="1" Grid.Column="1"
                       Text="{l:Loc Key=error.summary}"
                       TextWrapping="Wrap" Margin="0,6,0,0"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>

            <TextBlock Grid.Row="2" Grid.Column="1"
                       Text="{l:Loc Key=error.detailsLabel}" Margin="0,14,0,4"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
            <TextBox x:Name="DetailsBox"
                     Grid.Row="3" Grid.Column="1"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     FontFamily="Cascadia Mono,Consolas,monospace"
                     FontSize="11"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
        </Grid>
    </DockPanel>
</Window>
