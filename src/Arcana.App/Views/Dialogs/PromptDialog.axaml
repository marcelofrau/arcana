<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Arcana.App.ViewModels"
        xmlns:l="using:Arcana.App.Localization"
        xmlns:icons="using:Arcana.App.Icons"
        x:Class="Arcana.App.Views.Dialogs.PromptDialog"
        x:DataType="vm:PromptViewModel"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource AppSurfaceRaisedBrush}"
        Title="{Binding Title}">
    <StackPanel Margin="20" Spacing="12">
        <TextBlock Text="{Binding Title}"
                   FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource AppTextPrimaryBrush}"/>
        <TextBox Text="{Binding Value, Mode=TwoWay}"
                 Background="{DynamicResource AppBackgroundBrush}"
                 Foreground="{DynamicResource AppTextPrimaryBrush}"
                 BorderBrush="{DynamicResource AppBorderBrush}"
                 Padding="6,3"
                 MinWidth="320"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button MinWidth="90" Classes="secondary" Click="OnCancelClick">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Image Width="14" Height="14" Stretch="Uniform"
                           Tag="{x:Static icons:IconKey.Close}"
                           Source="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource IconToImage}}"/>
                    <TextBlock Text="{l:Loc Key=common.cancel}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button MinWidth="90" Classes="accent"
                    Click="OnOkClick">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Image Width="14" Height="14" Stretch="Uniform"
                           Tag="{x:Static icons:IconKey.Check}"
                           Source="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource IconToImage}}"/>
                    <TextBlock Text="{l:Loc Key=common.ok}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </StackPanel>
</Window>
