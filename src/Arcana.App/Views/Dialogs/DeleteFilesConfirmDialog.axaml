<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Arcana.App.ViewModels"
        xmlns:l="using:Arcana.App.Localization"
        x:Class="Arcana.App.Views.Dialogs.DeleteFilesConfirmDialog"
        x:DataType="vm:DeleteFilesConfirmViewModel"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource AppSurfaceRaisedBrush}"
        Title="{Binding Title}">
    <StackPanel Margin="20" Spacing="16">
        <TextBlock Text="{Binding Title}"
                   FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource AppTextPrimaryBrush}"/>
        <TextBlock Text="{Binding Message}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
        <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4"
                Background="{DynamicResource AppSurfaceLowBrush}"
                MaxHeight="200">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="200">
                <ItemsControl ItemsSource="{Binding Files}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       FontFamily="Consolas, Monospace"
                                       FontSize="12"
                                       Margin="8,4"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                       TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <TextBlock Text="{Binding TotalSizeFormatted, StringFormat='Total: {0}'}"
                   FontSize="12"
                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                   HorizontalAlignment="Right"/>
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
            <Button MinWidth="110" Classes="secondary"
                    Click="OnCancelClick"
                    Content="{Binding CancelText}"/>
            <Button MinWidth="120" Classes="accent danger"
                    Click="OnConfirmClick"
                    Content="{Binding ConfirmText}"/>
        </StackPanel>
    </StackPanel>
</Window>