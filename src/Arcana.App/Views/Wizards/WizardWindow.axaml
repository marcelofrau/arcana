<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Arcana.App.Localization"
        xmlns:icons="using:Arcana.App.Icons"
        xmlns:vmw="using:Arcana.App.ViewModels.Wizard"
        xmlns:vw="using:Arcana.App.Views.Wizards"
        x:Class="Arcana.App.Views.Wizards.WizardWindow"
        x:CompileBindings="False"
        Width="640" Height="520"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource AppSurfaceLowBrush}"
        Title="{Binding Title}">
    <Grid ClipToBounds="True">
        <!-- Ambient glow orbs -->
        <Ellipse Width="420" Height="320" HorizontalAlignment="Center" VerticalAlignment="Top"
                 Margin="0,-200,0,0" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Offset="0" Color="{DynamicResource AppAccentGlowInner}"/>
                    <GradientStop Offset="1" Color="{DynamicResource AppAccentGlowOuter}"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect>
                <BlurEffect Radius="60"/>
            </Ellipse.Effect>
        </Ellipse>

        <Ellipse Width="460" Height="280" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                 Margin="0,0,0,-160" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Offset="0" Color="{DynamicResource AppAccentGlowInner}"/>
                    <GradientStop Offset="1" Color="{DynamicResource AppAccentGlowOuter}"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect>
                <BlurEffect Radius="55"/>
            </Ellipse.Effect>
        </Ellipse>

        <DockPanel>
            <!-- Header -->
            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource AppToolbarGradientBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1"
                    Padding="24,22">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                    <Border Width="56" Height="56" CornerRadius="14" VerticalAlignment="Top"
                            Background="{DynamicResource AppChipBg}" BorderBrush="{DynamicResource AppChipBorder}" BorderThickness="1">
                        <Image Width="28" Height="28" Stretch="Uniform"
                               Tag="{Binding HeaderIcon}"
                               Source="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource IconToImage}}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="5">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <TextBlock Text="{Binding Title}"
                                       FontSize="20" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                            <Border Grid.Column="1" CornerRadius="10" Padding="10,3"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource AppAccentSoft}" BorderBrush="{DynamicResource AppAccentSoftBorder}" BorderThickness="1">
                                <TextBlock Text="{Binding StepIndicatorText}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding Current.Description}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Footer -->
            <Border DockPanel.Dock="Bottom" Margin="24,14,24,20" Padding="0,12,0,0"
                    BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <Button Grid.Column="0" MinWidth="90" Classes="secondary"
                            HorizontalAlignment="Left"
                            IsVisible="{Binding IsFirst}"
                            Command="{Binding CancelCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Image Width="14" Height="14" Stretch="Uniform"
                                   Tag="{x:Static icons:IconKey.Close}"
                                   Source="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource IconToImage}}"/>
                            <TextBlock Text="{l:Loc Key=common.cancel}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" MinWidth="90" Classes="secondary"
                            Command="{Binding BackCommand}"
                            IsEnabled="{Binding IsBackEnabled}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Image Width="14" Height="14" Stretch="Uniform"
                                   Tag="{x:Static icons:IconKey.ArrowBack}"
                                   Source="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource IconToImage}}"/>
                            <TextBlock Text="{l:Loc Key=wizard.back}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" MinWidth="110" Classes="accent"
                            Command="{Binding ForwardCommand}"
                            IsEnabled="{Binding CanForward}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Image Width="14" Height="14" Stretch="Uniform"
                                   Tag="{x:Static icons:IconKey.ArrowForward}"
                                   Source="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource IconToImage}}"/>
                            <TextBlock Text="{Binding ForwardLabel}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Step content (fills remaining space — must stay the last DockPanel child) -->
            <Border Margin="24,20,24,14" CornerRadius="12"
                    Background="{DynamicResource AppSurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                <ContentControl Content="{Binding Current}" Margin="20,16">
                    <ContentControl.DataTemplates>
                        <DataTemplate DataType="{x:Type vmw:CreateDestinationStep}">
                            <vw:CreateDestinationStepView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vmw:CreateFilesStep}">
                            <vw:CreateFilesStepView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vmw:CreatePasswordStep}">
                            <vw:CreatePasswordStepView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vmw:ExtractDestinationStep}">
                            <vw:ExtractDestinationStepView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vmw:ExtractOptionsStep}">
                            <vw:ExtractOptionsStepView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vmw:ConvertFormatStep}">
                            <vw:ConvertFormatStepView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vmw:ConvertDestinationStep}">
                            <vw:ConvertDestinationStepView/>
                        </DataTemplate>
                    </ContentControl.DataTemplates>
                </ContentControl>
            </Border>
        </DockPanel>
    </Grid>
</Window>
