<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmw="using:Arcana.App.ViewModels.Wizard"
             xmlns:l="using:Arcana.App.Localization"
             xmlns:icons="using:Arcana.App.Icons"
             x:Class="Arcana.App.Views.Wizards.ExtractDestinationStepView"
             x:DataType="vmw:ExtractDestinationStep">
    <StackPanel Spacing="14">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="12">
            <TextBlock Text="{l:Loc Key=wizard.extract.destLabel}" VerticalAlignment="Center"
                       Foreground="{DynamicResource AppTextPrimaryBrush}"/>
            <TextBox Grid.Column="1" Text="{Binding DestinationDir, Mode=TwoWay}"
                     PlaceholderText="{l:Loc Key=wizard.extract.destWatermark}"
                     Background="{DynamicResource AppBackgroundBrush}"
                     Foreground="{DynamicResource AppTextPrimaryBrush}"
                     BorderBrush="{DynamicResource AppBorderBrush}"
                     Padding="6,4"/>
            <Button Grid.Column="2" MinWidth="90" Classes="secondary"
                    Click="OnBrowseClick">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Image Width="14" Height="14" Stretch="Uniform"
                           Tag="{x:Static icons:IconKey.Folder}"
                           Source="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource IconToImage}}"/>
                    <TextBlock Text="{l:Loc Key=common.browse}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <TextBlock Grid.Row="1" Text="{l:Loc Key=wizard.extract.subfolderLabel}" VerticalAlignment="Center"
                       Foreground="{DynamicResource AppTextPrimaryBrush}"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SubfolderName, Mode=TwoWay}"
                     Background="{DynamicResource AppBackgroundBrush}"
                     Foreground="{DynamicResource AppTextPrimaryBrush}"
                     BorderBrush="{DynamicResource AppBorderBrush}"
                     Padding="6,4"/>
        </Grid>

        <CheckBox IsChecked="{Binding SmartSubfolder}" ToolTip.Tip="{l:Loc Key=wizard.extract.smartTip}">
            <TextBlock Text="{l:Loc Key=wizard.extract.smartLabel}"
                       Foreground="{DynamicResource AppTextPrimaryBrush}"/>
        </CheckBox>

        <TextBlock Text="{l:Loc Key=wizard.extract.subfolderHint}"
                   FontSize="12"
                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
    </StackPanel>
</UserControl>