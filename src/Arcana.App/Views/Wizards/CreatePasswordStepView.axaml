<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmw="using:Arcana.App.ViewModels.Wizard"
             xmlns:l="using:Arcana.App.Localization"
             x:Class="Arcana.App.Views.Wizards.CreatePasswordStepView"
             x:DataType="vmw:CreatePasswordStep">
    <StackPanel Spacing="14">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="12">
            <TextBlock Text="{l:Loc Key=wizard.create.passwordLabel}" VerticalAlignment="Center"
                       Foreground="{DynamicResource AppTextPrimaryBrush}"/>
            <TextBox Grid.Column="1" PasswordChar="●"
                     Text="{Binding Password, Mode=TwoWay}"
                     Background="{DynamicResource AppBackgroundBrush}"
                     BorderBrush="{DynamicResource AppBorderBrush}"
                     Padding="6,4"/>

            <TextBlock Grid.Row="1" Text="{l:Loc Key=wizard.create.confirmLabel}" VerticalAlignment="Center"
                       Foreground="{DynamicResource AppTextPrimaryBrush}"/>
            <TextBox Grid.Row="1" Grid.Column="1" PasswordChar="●"
                     Text="{Binding Confirm, Mode=TwoWay}"
                     Background="{DynamicResource AppBackgroundBrush}"
                     BorderBrush="{DynamicResource AppBorderBrush}"
                     Padding="6,4"/>
        </Grid>

        <TextBlock Text="{l:Loc Key=wizard.create.passwordHint}"
                   FontSize="12"
                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
    </StackPanel>
</UserControl>
