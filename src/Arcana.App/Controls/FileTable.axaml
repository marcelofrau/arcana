<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Arcana.App.ViewModels"
             xmlns:l="using:Arcana.App.Localization"
             x:Class="Arcana.App.Controls.FileTable"
             x:DataType="vm:MainViewModel">
    <DataGrid x:Name="Grid"
              ItemsSource="{Binding Archive.Entries}"
              SelectedItem="{Binding Archive.SelectedItem, Mode=TwoWay}"
              AutoGenerateColumns="False"
              CanUserSortColumns="True"
              CanUserReorderColumns="True"
              CanUserResizeColumns="True"
              IsReadOnly="True"
              SelectionMode="Extended"
              GridLinesVisibility="Horizontal"
              SelectionChanged="OnSelectionChanged"
              DoubleTapped="OnDoubleTapped"
              KeyDown="OnKeyDown">
        <DataGrid.Columns>
            <DataGridTemplateColumn Header="{l:Loc Key=filetable.name}" SortMemberPath="Name" Width="2*">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:FileEntryItem">
                        <Border Padding="8,0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Image Source="{Binding Icon, Converter={StaticResource IconToImage}}"
                                       Width="16" Height="16" Stretch="Uniform"
                                       VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="{l:Loc Key=filetable.size}" Binding="{Binding SizeText}"
                                SortMemberPath="SizeValue" Width="90"/>
            <DataGridTextColumn Header="{l:Loc Key=filetable.packed}" Binding="{Binding PackedText}"
                                SortMemberPath="PackedValue" Width="90"/>
            <DataGridTextColumn Header="{l:Loc Key=filetable.ratio}" Binding="{Binding RatioText}"
                                SortMemberPath="RatioValue" Width="60"/>
            <DataGridTextColumn Header="{l:Loc Key=filetable.type}" Binding="{Binding TypeText}"
                                SortMemberPath="TypeValue" Width="90"/>
            <DataGridTextColumn Header="{l:Loc Key=filetable.modified}" Binding="{Binding ModifiedText}"
                                SortMemberPath="ModifiedText" Width="150"/>
        </DataGrid.Columns>
    </DataGrid>
</UserControl>
