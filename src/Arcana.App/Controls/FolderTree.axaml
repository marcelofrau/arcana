<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Arcana.App.ViewModels"
             xmlns:core="using:Arcana.Core.Filesystem"
             x:Class="Arcana.App.Controls.FolderTree"
             x:DataType="vm:MainViewModel">
    <TreeView x:Name="Tree"
              ItemsSource="{Binding Archive.TreeNodes}"
              SelectedItem="{Binding Archive.CurrentNode, Mode=TwoWay}"
              Background="Transparent"
              Foreground="{DynamicResource AppTextPrimaryBrush}">
        <TreeView.ItemTemplate>
            <TreeDataTemplate ItemsSource="{Binding ChildFolders}" x:DataType="core:ArchiveNode">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Image Source="{Binding Converter={StaticResource NodeIcon}}"
                           Width="16" Height="16" Stretch="Uniform"
                           VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                </StackPanel>
            </TreeDataTemplate>
        </TreeView.ItemTemplate>
    </TreeView>
</UserControl>
