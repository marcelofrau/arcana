<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="using:Arcana.App.Icons"
             xmlns:conv="using:Arcana.App.Converters"
             x:Class="Arcana.App.App"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
        <StyleInclude Source="avares://Arcana.App/Themes/Controls.axaml"/>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Arcana.App/Themes/Colors.axaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Fluent accent (overridden at runtime by ColorThemeService) -->
            <Color x:Key="SystemAccentColor">#8B5CF6</Color>

            <icons:IconKeyToImageConverter x:Key="IconToImage"/>
            <icons:NodeIconConverter x:Key="NodeIcon"/>
            <conv:EqualsConverter x:Key="Equals"/>
            <conv:InvertBoolConverter x:Key="Invert"/>
            <conv:ExtractStatusTextConverter x:Key="ExtractStatusText"/>
            <conv:ExtractStatusBrushConverter x:Key="ExtractStatusBrush"/>

            <!-- DataGrid overrides (tokens are pushed at runtime by ColorThemeService) -->
            <SolidColorBrush x:Key="DataGridBackgroundBrush" Color="{DynamicResource AppSurface}"/>
            <SolidColorBrush x:Key="DataGridHeaderBackgroundBrush" Color="{DynamicResource AppSurfaceRaised}"/>
            <SolidColorBrush x:Key="DataGridGridLinesBrush" Color="{DynamicResource AppBorder}"/>
            <SolidColorBrush x:Key="DataGridRowHoverBackgroundBrush" Color="{DynamicResource AppHover}"/>
            <SolidColorBrush x:Key="DataGridRowSelectedBackgroundBrush" Color="{DynamicResource AppSelectionStrong}"/>
            <SolidColorBrush x:Key="DataGridRowSelectedUnfocusedBackgroundBrush" Color="{DynamicResource AppSelectionUnfocused}"/>
            <SolidColorBrush x:Key="DataGridCellSelectedBackgroundBrush" Color="{DynamicResource AppSelectionStrong}"/>
<SolidColorBrush x:Key="DataGridCellFocusVisualPrimaryBrush" Color="Transparent"/>
<SolidColorBrush x:Key="DataGridCellFocusVisualSecondaryBrush" Color="Transparent"/>
<SolidColorBrush x:Key="DataGridCurrencyVisualPrimaryBrush" Color="Transparent"/>
<SolidColorBrush x:Key="DataGridColumnHeaderForegroundBrush" Color="{DynamicResource AppTextSecondary}"/>
            <SolidColorBrush x:Key="DataGridColumnHeaderHoverBackgroundBrush" Color="{DynamicResource AppHover}"/>
            <SolidColorBrush x:Key="DataGridColumnHeaderPressedBackgroundBrush" Color="{DynamicResource AppBorder}"/>
            <SolidColorBrush x:Key="DataGridCellForegroundBrush" Color="{DynamicResource AppTextPrimary}"/>
        </ResourceDictionary>
    </Application.Resources>

</Application>
